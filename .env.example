# Environment variables for Iberian Chronicles
# Copy this file to .env and fill in your values

# MongoDB connection string
MONGODB_URI=mongodb://iberian:iberian_pass@your-vps-ip:27017/iberian_chronicles?authSource=admin

# Session secret (use a long random string)
SESSION_SECRET=change-me-to-a-random-secret

# Server port
PORT=3000

# Environment
NODE_ENV=development

# Base URL (for share links)
BASE_URL=https://iberianchronicles.nulkode.dev

# Admin seed (created on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@iberianchronicles.com
ADMIN_PASSWORD=change-me
