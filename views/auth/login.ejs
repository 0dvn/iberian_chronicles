<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Login', extraCSS: ['/styles/auth.css'] }) %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="page-main" tabindex="-1">
    <div class="page-container">
      <div class="auth-card">
        <h2 class="page-title">Log In</h2>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="post" class="auth-form">
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="username">
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <input class="form-input" type="password" id="password" name="password" placeholder="Your password" required autocomplete="current-password">
          </div>

          <button class="btn btn-primary" type="submit">Log In</button>
        </form>

        <p class="auth-footer">Don't have an account? <a href="/auth/register">Register</a></p>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
