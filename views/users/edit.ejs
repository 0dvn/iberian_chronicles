<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Edit Profile', extraCSS: ['/styles/profile.css'] }) %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="page-main" tabindex="-1">
    <div class="page-container">
      <div class="auth-card">
        <h2 class="page-title">Edit Profile</h2>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>

        <form action="/users/<%= user.username %>?_method=PUT" method="post" enctype="multipart/form-data" class="auth-form">
          <div class="form-group avatar-upload">
            <img class="avatar-preview" src="<%= user.avatar %>" alt="Current avatar for <%= user.username %>">
            <label class="form-label" for="avatar">Profile Photo</label>
            <input class="form-input" type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/webp">
          </div>

          <div class="form-group">
            <label class="form-label" for="username">Username</label>
            <input class="form-input" type="text" id="username" value="<%= user.username %>" disabled>
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" value="<%= user.email %>" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="bio">Bio</label>
            <textarea class="form-textarea" id="bio" name="bio" rows="4" placeholder="Tell us about yourself"><%= user.bio %></textarea>
          </div>

          <button class="btn btn-primary" type="submit">Save Changes</button>
        </form>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
