<!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Manage Users', extraCSS: ['/styles/admin.css'] }) %>
</head>
<body>
  <%- include('../partials/header') %>

  <main id="page-main" tabindex="-1">
    <div class="page-container">
      <div class="admin-header">
        <h2 class="page-title">Manage Users</h2>
        <span class="user-count"><%= users.length %> users</span>
      </div>

      <table class="admin-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Current Role</th>
            <th>Change Role</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
          <tr>
            <td data-label="User">
              <div class="user-cell">
                <img src="<%= user.avatar %>" alt="<%= user.username %>">
                <a class="user-name" href="/users/<%= user.username %>"><%= user.username %></a>
              </div>
            </td>
            <td data-label="Email"><span class="user-email"><%= user.email %></span></td>
            <td data-label="Role"><span class="role-badge <%= user.role %>"><%= user.role %></span></td>
            <td data-label="Change Role">
              <% if (user._id.toString() === currentUser._id) { %>
              <span class="user-email">Cannot modify</span>
              <% } else { %>
              <form class="role-form" action="/admin/users/<%= user._id %>/role" method="post">
                <select name="role">
                  <option value="visitor" <%= user.role === 'visitor' ? 'selected' : '' %>>Visitor</option>
                  <option value="editor" <%= user.role === 'editor' ? 'selected' : '' %>>Editor</option>
                  <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
                <button class="btn-save" type="submit">Save</button>
              </form>
              <% } %>
            </td>
            <td data-label="Actions">
              <% if (user._id.toString() === currentUser._id) { %>
              <span class="user-email">&mdash;</span>
              <% } else { %>
              <form action="/admin/users/<%= user._id %>/delete" method="post" onsubmit="return confirm('Delete this user and all their content?')">
                <button class="btn-delete" type="submit">Delete</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
